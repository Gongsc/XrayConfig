#!/usr/bin/env bash

set -euo pipefail

url="${*: -1}"
case "$url" in
  */repos/caddyserver/caddy/releases/latest)
    version="${FAKE_CADDY_LATEST:-2.11.4}"
    ;;
  */repos/XTLS/Xray-core/releases\?per_page=1)
    version="${FAKE_XRAY_LATEST:-26.9.9}"
    ;;
  */repos/vikiboss/60s/releases/latest)
    version="${FAKE_SIXTY_SECONDS_LATEST:-2.54.0}"
    ;;
  *)
    printf 'unexpected release API URL: %s\n' "$url" >&2
    exit 1
    ;;
esac

printf '{"tag_name":"v%s"}\n' "$version"
