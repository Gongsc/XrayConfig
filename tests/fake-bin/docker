#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" == "info" ]]; then
  exit 0
fi

if [[ "${1:-}" == "inspect" ]]; then
  printf '%s\n' 'sha256:current'
  exit 0
fi

if [[ "${1:-}" == "image" && "${2:-}" == "inspect" ]]; then
  if [[ "${FAKE_UPDATE_AVAILABLE:-false}" == "true" ]]; then
    printf '%s\n' 'sha256:latest'
  else
    printf '%s\n' 'sha256:current'
  fi
  exit 0
fi

if [[ "${1:-}" == "image" && "${2:-}" == "tag" ]]; then
  if [[ -n "${FAKE_DOCKER_LOG:-}" ]]; then
    printf '%s\n' "image tag ${*:3}" >>"$FAKE_DOCKER_LOG"
  fi
  exit 0
fi

if [[ "${1:-}" == "run" ]]; then
  case "${*: -1}" in
    uuid)
      printf '%s\n' '11111111-2222-4333-8444-555555555555'
      ;;
    x25519)
      printf '%s\n' \
        'PrivateKey: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA' \
        'Password (PublicKey): BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB' \
        'Hash32: CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC'
      ;;
    *)
      printf 'unexpected docker run command: %s\n' "$*" >&2
      exit 1
      ;;
  esac
  exit 0
fi

if [[ "${1:-}" != "compose" ]]; then
  printf 'unexpected docker command: %s\n' "$*" >&2
  exit 1
fi
shift

if [[ "${1:-}" == "version" ]]; then
  printf '%s\n' 'Docker Compose version v2.test'
  exit 0
fi

while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --project-directory|--env-file|--profile)
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

case "${1:-}" in
  ps)
    if [[ "${FAKE_UPDATE_AVAILABLE:-false}" == "true" ]]; then
      case "${*: -1}" in
        caddy|xray|news-api) printf '%s\n' "fake-${*: -1}-container" ;;
      esac
    fi
    exit 0
    ;;
  up)
    if [[ -n "${FAKE_DOCKER_LOG:-}" ]]; then
      printf '%s\n' "up $*" >>"$FAKE_DOCKER_LOG"
    fi
    exit 0
    ;;
  config|run|down|restart|logs|pull)
    exit 0
    ;;
  *)
    printf 'unexpected docker compose command: %s\n' "$*" >&2
    exit 1
    ;;
esac
