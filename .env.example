# DNS-only domain whose A/AAAA records point directly to this VPS.
DOMAIN=example.com

# Optional ACME account email. Leave empty to let Caddy register without one.
ACME_EMAIL=

# Display name used in the generated VLESS URI.
CLIENT_NAME=home-reality

# Pinned official images. Change these deliberately when upgrading.
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.7.11
CADDY_IMAGE=caddy:2.11.4-alpine

